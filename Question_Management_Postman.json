                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/questions?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "questions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
